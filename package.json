{
  "name": "expecct",
  "productName": "Expecct",
  "version": "3.1.1",
  "description": "Expecct - ChatGPT, Claude and Gemini in their own window. Any size, any place, your style.",
  "main": "main.js",
  "author": "Expecct",
  "license": "UNLICENSED",
  "exacctAi": "chatgpt",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "no.expect.exacctai",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "icon.png",
      "package.json"
    ],
    "icon": "icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "${productName}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Expecct uses the microphone when you talk to your AI.",
        "NSCameraUsageDescription": "Expecct uses the camera when you share a photo with your AI."
      }
    },
    "dmg": {
      "title": "Expecct",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    }
  },
  "repository": "https://github.com/rehat2009-dev/exacct-ai"
}
